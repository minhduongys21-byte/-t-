local function row(text)
    local frame = make("Frame", {
        Size = UDim2.new(1, -4, 0, 38),
        BackgroundColor3 = Color3.fromRGB(35, 44, 59),
        BorderSizePixel = 0
    }, content)
    corner(frame, 6)

    label(frame, text, UDim2.new(1, -92, 1, 0),
        UDim2.new(0, 8, 0, 0), 13)

    local button = make("TextButton", {
        Size = UDim2.new(0, 72, 0, 28),
        Position = UDim2.new(1, -78, 0.5, -14),
        BackgroundColor3 = Color3.fromRGB(70, 76, 88),
        Text = "OFF",
        TextColor3 = Color3.new(1, 1, 1),
        TextSize = 12,
        Font = Enum.Font.GothamBold
    }, frame)
    corner(button, 6)

    return button
end

local function toggleRow(text, key, callback)
    local button = row(text)

    local function refresh()
        button.Text = state[key] and "ON" or "OFF"
        button.BackgroundColor3 = state[key]
            and Color3.fromRGB(35, 170, 80)
            or Color3.fromRGB(70, 76, 88)
    end

    button.Activated:Connect(function()
        state[key] = not state[key]
        refresh()
        if callback then callback(state[key]) end
    end)

    refresh()
end

local function sliderRow(text, key, callback)
    local frame = make("Frame", {
        Size = UDim2.new(1, -4, 0, 54),
        BackgroundColor3 = Color3.fromRGB(35, 44, 59),
        BorderSizePixel = 0
    }, content)
    corner(frame, 6)

    local valueLabel = label(frame, text .. ": " .. state[key],
        UDim2.new(1, -12, 0, 24), UDim2.new(0, 8, 0, 2), 13)

    local bar = make("TextButton", {
        Size = UDim2.new(1, -18, 0, 12),
        Position = UDim2.new(0, 9, 0, 34),
        BackgroundColor3 = Color3.fromRGB(70, 80, 96),
        Text = "",
        AutoButtonColor = false
    }, frame)
    corner(bar, 6)

    local fill = make("Frame", {
        Size = UDim2.new(state[key] / 100, 0, 1, 0),
        BackgroundColor3 = Color3.fromRGB(40, 200, 105),
        BorderSizePixel = 0
    }, bar)
    corner(fill, 6)

    local function setFromX(x)
        local width = math.max(bar.AbsoluteSize.X, 1)
        local percent = math.clamp(
            (x - bar.AbsolutePosition.X) / width, 0, 1
        )
        state[key] = math.clamp(math.floor(percent * 100 + 0.5), 1, 100)
        valueLabel.Text = text .. ": " .. state[key]
        fill.Size = UDim2.new(state[key] / 100, 0, 1, 0)
        if callback then callback(state[key]) end
    end

    bar.Activated:Connect(function(input)
        setFromX(input.Position.X)
    end)

    bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch
            or input.UserInputType == Enum.UserInputType.MouseButton1 then
            setFromX(input.Position.X)
        end
    end)
end

