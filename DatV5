local flyAttachment
local flyVelocity

local function stopFly()
    state.Fly = false
    state.Vertical = 0
    flyControls.Visible = false
    if flyVelocity then
        flyVelocity:Destroy()
        flyVelocity = nil
    end
    if flyAttachment then
        flyAttachment:Destroy()
        flyAttachment = nil
    end
end

local function startFly()
    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then return end

    stopFly()
    state.Fly = true
    flyControls.Visible = true

    flyAttachment = Instance.new("Attachment")
    flyAttachment.Parent = root

    flyVelocity = Instance.new("LinearVelocity")
    flyVelocity.Attachment0 = flyAttachment
    flyVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
    flyVelocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
    flyVelocity.VectorVelocity = Vector3.zero
    flyVelocity.MaxForce = math.huge
    flyVelocity.Parent = root
end

RunService.Heartbeat:Connect(function()
    if not state.Fly or not flyVelocity then return end

    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then
        stopFly()
        return
    end

    local camera = workspace.CurrentCamera
    local move = Vector3.zero

    if camera then
        local forward = camera.CFrame.LookVector
        local right = camera.CFrame.RightVector

        if UIS:IsKeyDown(Enum.KeyCode.W) then move += forward end
        if UIS:IsKeyDown(Enum.KeyCode.S) then move -= forward end
        if UIS:IsKeyDown(Enum.KeyCode.D) then move += right end
        if UIS:IsKeyDown(Enum.KeyCode.A) then move -= right end
    end

    flyVelocity.VectorVelocity =
        move * (state.FlyValue * 0.5) +
        Vector3.new(0, state.Vertical * (state.FlyValue * 0.5), 0)
end)

local espObjects = {}

local function clearESP()
    for _, obj in pairs(espObjects) do
        if obj and obj.Parent then obj:Destroy() end
    end
    table.clear(espObjects)
end

local function updateESP()
    clearESP()
    if not state.ESP then return end

    for _, other in ipairs(Players:GetPlayers()) do
        if other ~= player and other.Character then
            local highlight = Instance.new("Highlight")
            highlight.Name = "DAT_CHUA_ESP"
            highlight.FillTransparency = 0.75
            highlight.OutlineColor = Color3.fromRGB(60, 255, 110)
            highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            highlight.Adornee = other.Character
            highlight.Parent = gui
            table.insert(espObjects, highlight)
        end
    end
end

local function buildTab(tab)
    currentTab = tab
    clearContent()

    for name, button in pairs(tabsButtons) do
        button.BackgroundColor3 = name == tab
            and Color3.fromRGB(45, 120, 200)
            or Color3.fromRGB(38, 45, 58)
    end

    if tab == "ESP" then
        toggleRow("ESP Line", "Line")
        toggleRow("ESP Box", "Box")
        toggleRow("Health Bar", "Health")
        toggleRow("ESP Name", "Name")
        toggleRow("ESP Distance", "Distance")
        toggleRow("ESP Highlight", "ESP", updateESP)

    elseif tab == "AIM" then
        toggleRow("Aim Assist", "Aim", refreshFOV)
        toggleRow("Show FOV", "ShowFOV", refreshFOV)
        sliderRow("FOV", "FOV", refreshFOV)

        label(content,
            "Aim Assist hien tai chi bat/tat vong FOV; chua tu dong nham.",
            UDim2.new(1, -8, 0, 42), UDim2.new(), 11)

    elseif tab == "SPEED" then
        toggleRow("Speed", "Speed", function(enabled)
            local char = player.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hum then
                hum.WalkSpeed = enabled and state.SpeedValue or 16
            end
        end)

        sliderRow("Speed Value", "SpeedValue", function(value)
            if state.Speed then
                local char = player.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                if hum then hum.WalkSpeed = value end
            end
        end)

        toggleRow("Fly", "Fly", function(enabled)
            if enabled then
                startFly()
            else
                stopFly()
            end
        end)

        sliderRow("Fly Value", "FlyValue")
    end
end

for i, name in ipairs({"ESP", "AIM", "SPEED"}) do
