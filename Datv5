local function section(text, y)
    local t = label(
        scroll, text,
        UDim2.new(1, -4, 0, 25),
        UDim2.new(0, 2, 0, y)
    )
    t.TextXAlignment = Enum.TextXAlignment.Left
    t.TextColor3 = Color3.fromRGB(255, 90, 100)
end

local function toggle(name, y, callback)
    label(
        scroll, name,
        UDim2.new(0, 155, 0, 32),
        UDim2.new(0, 2, 0, y)
    ).TextXAlignment = Enum.TextXAlignment.Left

    local on = false
    local b = button(
        scroll, "OFF",
        UDim2.new(0, 88, 0, 29),
        UDim2.new(1, -92, 0, y + 1)
    )

    b.Activated:Connect(function()
        on = not on
        b.Text = on and "ON" or "OFF"
        b.BackgroundColor3 = on
            and Color3.fromRGB(25, 145, 80)
            or Color3.fromRGB(48, 48, 60)

        callback(on)
    end)

    return b
end

