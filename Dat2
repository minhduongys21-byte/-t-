local values = {}

local function addToggle(title)
    local row = create("Frame", {
        Size = UDim2.new(1, -4, 0, 42),
        BackgroundColor3 = PANEL,
        BorderSizePixel = 0
    }, scroll)

    create("UICorner", {
        CornerRadius = UDim.new(0, 8)
    }, row)

    create("TextLabel", {
        Size = UDim2.new(1, -90, 1, 0),
        Position = UDim2.fromOffset(10, 0),
        BackgroundTransparency = 1,
        Text = title,
        TextColor3 = WHITE,
        Font = Enum.Font.Gotham,
        TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Left
    }, row)

    local on = false
    local button = create("TextButton", {
        Size = UDim2.fromOffset(70, 28),
        Position = UDim2.new(1, -78, 0.5, -14),
        BackgroundColor3 = Color3.fromRGB(75, 75, 80),
        Text = "OFF",
        TextColor3 = WHITE,
        Font = Enum.Font.GothamBold,
        TextSize = 13
    }, row)

    create("UICorner", {
        CornerRadius = UDim.new(0, 7)
    }, button)

    values[title] = false

    button.Activated:Connect(function()
        on = not on
        values[title] = on
        button.Text = on and "ON" or "OFF"
        button.BackgroundColor3 = on and RED
            or Color3.fromRGB(75, 75, 80)
    end)
end

local function addSlider(title)
    local row = create("Frame", {
        Size = UDim2.new(1, -4, 0, 58),
        BackgroundColor3 = PANEL,
        BorderSizePixel = 0
    }, scroll)

    create("UICorner", {
        CornerRadius = UDim.new(0, 8)
    }, row)

    create("TextLabel", {
        Size = UDim2.new(1, -45, 0, 25),
        Position = UDim2.fromOffset(10, 0),
        BackgroundTransparency = 1,
        Text = title,
        TextColor3 = WHITE,
        Font = Enum.Font.Gotham,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left
    }, row)

    local number = create("TextLabel", {
        Size = UDim2.fromOffset(35, 25),
        Position = UDim2.new(1, -42, 0, 0),
        BackgroundTransparency = 1,
        Text = "50",
        TextColor3 = RED,
        Font = Enum.Font.GothamBold,
        TextSize = 14
    }, row)

    local bar = create("TextButton", {
        Size = UDim2.new(1, -20, 0, 12),
        Position = UDim2.fromOffset(10, 34),
        BackgroundColor3 = Color3.fromRGB(75, 75, 80),
        Text = "",
        AutoButtonColor = false
    }, row)

    create("UICorner", {
        CornerRadius = UDim.new(1, 0)
    }, bar)

    local fill = create("Frame", {
        Size = UDim2.new(0.5, 0, 1, 0),
        BackgroundColor3 = RED,
        BorderSizePixel = 0
    }, bar)

    create("UICorner", {
        CornerRadius = UDim.new(1, 0)
    }, fill)

    values[title] = 50

    local dragging = false

    local function update(x)
        local width = bar.AbsoluteSize.X
        if width <= 0 then return end

        local percent = math.clamp(
            (x - bar.AbsolutePosition.X) / width,
            0, 1
        )

        local value = math.clamp(
            math.floor(percent * 99 + 1), 1, 100
        )

        values[title] = value
        number.Text = tostring(value)
        fill.Size = UDim2.new(percent, 0, 1, 0)
    end

    bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch
        or input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            update(input.Position.X)
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if dragging and (
            input.UserInputType == Enum.UserInputType.Touch
            or input.UserInputType == Enum.UserInputType.MouseMovement
        ) then
            update(input.Position.X)
        end
    end)

    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch
        or input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
end

