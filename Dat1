local function addToggle(parent, name, y, callback)
    local button = make("TextButton", {
        Position = UDim2.fromOffset(5, y),
        Size = UDim2.new(1, -10, 0, 34),
        BackgroundColor3 = gray,
        TextColor3 = white,
        TextSize = 14,
        Font = Enum.Font.GothamBold,
        Text = name .. ": OFF"
    }, parent)

    make("UICorner", {
        CornerRadius = UDim.new(0, 7)
    }, button)

    local enabled = false

    button.Activated:Connect(function()
        enabled = not enabled
        button.Text = name .. (enabled and ": ON" or ": OFF")
        button.BackgroundColor3 = enabled and red or gray
        callback(enabled)
    end)

    return button
end

local function addSlider(parent, name, y, callback)
    local label = make("TextLabel", {
        Position = UDim2.fromOffset(5, y),
        Size = UDim2.new(1, -10, 0, 23),
        BackgroundTransparency = 1,
        Text = name .. ": 50",
        TextColor3 = white,
        TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Left
    }, parent)

    local track = make("TextButton", {
        Position = UDim2.fromOffset(5, y + 27),
        Size = UDim2.new(1, -10, 0, 12),
        Text = "",
        AutoButtonColor = false,
        BackgroundColor3 = gray
    }, parent)

    make("UICorner", {
        CornerRadius = UDim.new(1, 0)
    }, track)

    local fill = make("Frame", {
        Size = UDim2.new(0.5, 0, 1, 0),
        BackgroundColor3 = red
    }, track)

    make("UICorner", {
        CornerRadius = UDim.new(1, 0)
    }, fill)

    local dragging = false

    local function update(input)
        local width = track.AbsoluteSize.X
        if width <= 0 then return end

        local pct = math.clamp(
            (input.Position.X - track.AbsolutePosition.X) / width,
            0, 1
        )

        local value = math.clamp(
            math.floor(pct * 99 + 1), 1, 100
        )

        fill.Size = UDim2.new(pct, 0, 1, 0)
        label.Text = name .. ": " .. value
        callback(value)
    end

    track.Activated:Connect(function()
        -- Activated hỗ trợ thao tác chạm trên điện thoại.
    end)

    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            update(input)
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if dragging and (
            input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch
        ) then
            update(input)
        end
    end)

    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

